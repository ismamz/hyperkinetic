{
  "name": "hyperkinetic",
  "version": "0.1.0-alpha.0",
  "description": "Parallel page transitions for React Router on one shared GSAP timeline.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismamz/hyperkinetic.git"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepublishOnly": "pnpm build",
    "prepare": "simple-git-hooks",
    "dev": "pnpm dev:example",
    "dev:example": "pnpm build && pnpm --filter \"$FILTER\" dev",
    "build:example": "pnpm build && pnpm --filter \"$FILTER\" build",
    "dev:docs": "pnpm build && pnpm --filter docs dev",
    "build:docs": "FILTER=basic pnpm build:example && pnpm --filter docs build && rm -rf docs/build/client/basic && cp -R examples/basic/build/client docs/build/client/basic",
    "typecheck:docs": "pnpm --filter docs typecheck",
    "typecheck:example": "pnpm build && pnpm --filter \"$FILTER\" typecheck",
    "typecheck:browser": "pnpm build && tsc -p tests/browser/tsconfig.json",
    "test:unit": "pnpm build && node --test tests/unit/*.test.ts",
    "test:browser": "pnpm build && node scripts/browser-checks.mjs",
    "test:production": "FILTER=basic pnpm build:example && node scripts/check-production-debug.mjs",
    "test": "pnpm test:unit && pnpm test:browser && pnpm test:production"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged --concurrent false"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "peerDependencies": {
    "gsap": "^3.15.0",
    "react": "~19.2.8",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "gsap": "3.15.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.71.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
